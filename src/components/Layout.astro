---
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  lang?: 'fr' | 'en';
}

const {
  title,
  description,
  canonicalUrl,
  ogImage = '/og-default.png',
  lang = 'fr',
} = Astro.props;

const SITE_URL = 'https://petscore.ca';
const canonical = canonicalUrl ? `${SITE_URL}${canonicalUrl}` : Astro.url.href;

// hreflang alternates — only emit EN alternate when the EN page actually exists:
//   - /en/ homepage
//   - /en/breeds/ index
//   - /en/breeds/[slug] pages
//   - any page with lang='en' (EN pages always have a FR counterpart)
const frUrl = canonical.replace(`${SITE_URL}/en/`, `${SITE_URL}/fr/`);
const enUrl = canonical.replace(`${SITE_URL}/fr/races/`, `${SITE_URL}/en/breeds/`);
const hasEnAlternate =
  lang === 'en' ||
  canonical === `${SITE_URL}/fr/` ||
  canonical === `${SITE_URL}/fr/races/` ||
  /\/fr\/races\/[^/]+\/$/.test(canonical);   // /fr/races/[slug]/

// ogImage : accepte une URL absolue ou un chemin relatif
const ogImageFull = ogImage?.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`;

// og:locale — correct per language
const ogLocale = lang === 'en' ? 'en_CA' : 'fr_CA';
---

<!doctype html>
<html lang={lang} class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO primaire -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PetScore" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageFull} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageFull} />

    <!-- hreflang — only when EN counterpart actually exists -->
    {hasEnAlternate ? (
      <>
        <link rel="alternate" hreflang="fr-CA" href={frUrl} />
        <link rel="alternate" hreflang="en-CA" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={frUrl} />
      </>
    ) : (
      <>
        <link rel="alternate" hreflang="fr-CA" href={canonical} />
        <link rel="alternate" hreflang="x-default" href={canonical} />
      </>
    )}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts : Sora (titres) + Inter (corps) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />
  </head>

  <body class="flex min-h-full flex-col bg-white font-sans text-gray-900 antialiased">
    <!-- Header -->
    <header class="sticky top-0 z-50 border-b border-gray-100 bg-white/95 backdrop-blur-sm">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
        <!-- Logo -->
        <a href="/fr/" class="flex items-center gap-2 text-green-600 hover:text-green-700 transition-colors duration-200">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <circle cx="14" cy="14" r="14" fill="#16A34A"/>
            <path d="M8 14.5c0-1.5.8-2.5 2-3 .5-2 2-3.5 4-3.5s3.5 1.5 4 3.5c1.2.5 2 1.5 2 3 0 2-1.8 3.5-4 3.5H12C9.8 18 8 16.5 8 14.5z" fill="white"/>
            <circle cx="10.5" cy="9" r="1.5" fill="white"/>
            <circle cx="17.5" cy="9" r="1.5" fill="white"/>
            <circle cx="8.5" cy="12" r="1.5" fill="white"/>
            <circle cx="19.5" cy="12" r="1.5" fill="white"/>
          </svg>
          <span class="font-display text-xl font-bold tracking-tight">PetScore</span>
        </a>

        <!-- Navigation -->
        <nav aria-label="Navigation principale" class="flex items-center gap-1 sm:gap-2">
          <a
            href="/fr/races/"
            class="rounded-full px-3 py-2 text-sm font-semibold text-slate-600 transition-all duration-200 hover:bg-gray-100 sm:px-4"
          >
            Races
          </a>
          <a
            href="/fr/comparer/"
            class="hidden rounded-full px-3 py-2 text-sm font-semibold text-slate-600 transition-all duration-200 hover:bg-gray-100 sm:block sm:px-4"
          >
            Comparer
          </a>
          <a
            href="/fr/blog/"
            class="hidden rounded-full px-3 py-2 text-sm font-semibold text-slate-600 transition-all duration-200 hover:bg-gray-100 md:block md:px-4"
          >
            Blog
          </a>
          <a
            href="/fr/faq/"
            class="hidden rounded-full px-3 py-2 text-sm font-semibold text-slate-600 transition-all duration-200 hover:bg-gray-100 lg:block lg:px-4"
          >
            FAQ
          </a>
          <a
            href="/fr/urgence/"
            class="hidden rounded-full px-3 py-2 text-sm font-semibold text-red-600 transition-all duration-200 hover:bg-red-50 lg:block lg:px-4"
            title="Mon chien a besoin d'urgences ?"
          >
            🚨 Urgence
          </a>
          <!-- Recherche globale -->
          <button
            id="global-search-btn"
            type="button"
            aria-label="Rechercher"
            class="rounded-full p-2 text-slate-500 transition-all hover:bg-gray-100 hover:text-gray-700"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z" />
            </svg>
          </button>

          <a
            href="/fr/quiz/"
            class="rounded-full bg-green-600 px-3 py-2 text-sm font-semibold text-white transition-all duration-200 hover:bg-green-700 sm:px-4"
          >
            🐾 Quiz
          </a>
        </nav>
      </div>
    </header>

    <!-- Modal recherche globale -->
    <div id="search-modal" class="fixed inset-0 z-[100] hidden" role="dialog" aria-modal="true" aria-label="Recherche globale">
      <div id="search-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
      <div class="relative z-10 mx-auto mt-20 max-w-xl px-4">
        <div class="overflow-hidden rounded-2xl bg-white shadow-2xl">
          <div class="flex items-center gap-3 border-b border-gray-100 px-4 py-3">
            <svg class="h-5 w-5 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z" />
            </svg>
            <input
              id="search-modal-input"
              type="search"
              placeholder="Races, articles, conditions…"
              autocomplete="off"
              class="flex-1 text-sm text-gray-900 placeholder:text-slate-400 focus:outline-none"
            />
            <kbd class="hidden rounded border border-gray-200 px-1.5 py-0.5 text-xs text-slate-400 sm:block">Esc</kbd>
          </div>
          <ul id="search-modal-results" class="max-h-80 overflow-y-auto py-2">
            <li class="px-4 py-6 text-center text-sm text-slate-400">Commencez à taper…</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Contenu principal -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="mt-auto border-t border-gray-100 bg-gray-50">
      <div class="mx-auto max-w-6xl px-4 pt-12 pb-8 sm:px-6">

        <!-- 4-column footer grid -->
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4 mb-10">

          <!-- Colonne 1 : Brand -->
          <div>
            <a href="/fr/" class="flex items-center gap-2 text-green-600 hover:text-green-700 transition-colors mb-3">
              <svg width="24" height="24" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                <circle cx="14" cy="14" r="14" fill="#16A34A"/>
                <path d="M8 14.5c0-1.5.8-2.5 2-3 .5-2 2-3.5 4-3.5s3.5 1.5 4 3.5c1.2.5 2 1.5 2 3 0 2-1.8 3.5-4 3.5H12C9.8 18 8 16.5 8 14.5z" fill="white"/>
                <circle cx="10.5" cy="9" r="1.5" fill="white"/>
                <circle cx="17.5" cy="9" r="1.5" fill="white"/>
                <circle cx="8.5" cy="12" r="1.5" fill="white"/>
                <circle cx="19.5" cy="12" r="1.5" fill="white"/>
              </svg>
              <span class="font-display font-bold tracking-tight">PetScore™</span>
            </a>
            <p class="text-xs leading-relaxed text-slate-500 mb-4">
              Scores de santé prédictifs pour 50+ races de chiens au Québec. Budget, assurances, législation.
            </p>
            <div class="flex gap-3">
              <a href="/rss.xml" class="text-slate-400 hover:text-orange-500 transition-colors" aria-label="Flux RSS">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
                </svg>
              </a>
              <a href="/en/" class="text-xs font-medium text-slate-400 hover:text-green-600 transition-colors">EN</a>
            </div>
          </div>

          <!-- Colonne 2 : Races -->
          <div>
            <p class="mb-3 text-xs font-bold uppercase tracking-widest text-slate-400">Races</p>
            <ul class="space-y-2">
              <li><a href="/fr/races/" class="text-sm text-slate-600 hover:text-green-600 transition-colors">Toutes les races</a></li>
              <li><a href="/fr/races/groupes/" class="text-sm text-slate-600 hover:text-green-600 transition-colors">Groupes de races</a></li>
              <li><a href="/fr/races/top-familles/" class="text-sm text-slate-600 hover:text-green-600 transition-colors">Top races familles</a></li>
              <li><a href="/fr/races/races-hypoallergeniques/" class="text-sm text-slate-600 hover:text-green-600 transition-colors">Races hypoallergéniques</a></li>
              <li><a href="/fr/races/races-personnes-agees/" class="text-sm text-slate-600 hover:text-green-600 transition-colors">Races personnes âgées</a></li>
              <li><a href="/fr/races/races-longue-vie/" class="text-sm text-slate-600 hover:text-green-600 transition-colors">Longue espérance de vie</a></li>
              <li><a href="/fr/races/races-moins-cheres/" class="text-sm text-slate-600 hover:text-green-600 transition-colors">Races moins chères</a></li>
              <li><a href="/fr/races/races-interdites-quebec/" class="text-sm text-slate-600 hover:text-green-600 transition-colors">Races interdites QC</a></li>
            </ul>
          </div>

          <!-- Colonne 3 : Guides & Blog -->
          <div>
            <p class="mb-3 text-xs font-bold uppercase tracking-widest text-slate-400">Guides</p>
            <ul class="space-y-2">
              <li><a href="/fr/guide-premier-chien/" class="text-sm text-slate-600 hover:text-green-600 transition-colors">Guide premier chien</a></li>
              <li><a href="/fr/checklist-adoption/" class="text-sm text-slate-600 hover:text-green-600 transition-colors">Checklist adoption</a></li>
              <li><a href="/fr/faq/" class="text-sm text-slate-600 hover:text-green-600 transition-colors">FAQ — Questions fréquentes</a></li>
              <li><a href="/fr/blog/" class="text-sm text-slate-600 hover:text-green-600 transition-colors">Blog santé canine</a></li>
              <li><a href="/fr/conditions/" class="text-sm text-slate-600 hover:text-green-600 transition-colors">Conditions médicales</a></li>
              <li><a href="/fr/glossaire/" class="text-sm text-slate-600 hover:text-green-600 transition-colors">Glossaire vétérinaire</a></li>
              <li><a href="/fr/methodologie/" class="text-sm text-slate-600 hover:text-green-600 transition-colors">Méthodologie</a></li>
            </ul>
          </div>

          <!-- Colonne 4 : Outils -->
          <div>
            <p class="mb-3 text-xs font-bold uppercase tracking-widest text-slate-400">Outils</p>
            <ul class="space-y-2">
              <li><a href="/fr/quiz/" class="text-sm text-slate-600 hover:text-green-600 transition-colors">🐾 Quiz race idéale</a></li>
              <li><a href="/fr/comparer/" class="text-sm text-slate-600 hover:text-green-600 transition-colors">⚖️ Comparer 2 races</a></li>
              <li><a href="/fr/assurance/" class="text-sm text-slate-600 hover:text-green-600 transition-colors">Assurances animaux</a></li>
              <li><a href="/fr/calendrier/" class="text-sm text-slate-600 hover:text-green-600 transition-colors">Calendrier santé</a></li>
              <li><a href="/fr/urgence/" class="text-sm text-red-500 hover:text-red-600 transition-colors font-medium">🚨 Urgence vétérinaire</a></li>
              <li><a href="/fr/favoris/" class="text-sm text-slate-600 hover:text-green-600 transition-colors">❤️ Mes favoris</a></li>
              <li><a href="/fr/races/prix-races-chiens/" class="text-sm text-slate-600 hover:text-green-600 transition-colors">Prix d'achat races</a></li>
            </ul>
          </div>
        </div>

        <!-- Bottom bar -->
        <div class="border-t border-gray-200 pt-6 flex flex-col items-center gap-3 sm:flex-row sm:justify-between">
          <p class="text-xs leading-relaxed text-slate-400 max-w-xl text-center sm:text-left">
            <strong class="text-slate-500">Avis légal :</strong> Les informations sont des estimations à titre éducatif seulement et ne constituent pas un avis vétérinaire.
          </p>
          <div class="flex flex-wrap gap-x-4 gap-y-1 justify-center">
            <a href="/fr/a-propos/" class="text-xs text-slate-400 hover:text-green-600 transition-colors">À propos</a>
            <a href="/fr/confidentialite/" class="text-xs text-slate-400 hover:text-green-600 transition-colors">Confidentialité</a>
            <a href="/en/" class="text-xs text-slate-400 hover:text-green-600 transition-colors">English</a>
            <span class="text-xs text-slate-300">&copy; {new Date().getFullYear()} PetScore™</span>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

<script>
// ── Recherche globale — Fuse.js chargé depuis CDN ────────────────────────────
const btn       = document.getElementById('global-search-btn');
const modal     = document.getElementById('search-modal');
const backdrop  = document.getElementById('search-backdrop');
const input     = document.getElementById('search-modal-input') as HTMLInputElement | null;
const resultsList = document.getElementById('search-modal-results');

let fuseInstance: any = null;
let indexLoaded = false;

const TYPE_ICON: Record<string, string> = {
  breed:     '🐕',
  blog:      '📝',
  condition: '🩺',
  page:      '📄',
};
const TYPE_LABEL: Record<string, string> = {
  breed:     'Race',
  blog:      'Article',
  condition: 'Condition',
  page:      'Page',
};

function openModal() {
  modal?.classList.remove('hidden');
  input?.focus();
  document.body.style.overflow = 'hidden';
  if (!indexLoaded) loadIndex();
}
function closeModal() {
  modal?.classList.add('hidden');
  document.body.style.overflow = '';
  if (input) input.value = '';
  renderResults([]);
}

function renderResults(items: any[]) {
  if (!resultsList) return;
  if (!items.length && input?.value) {
    resultsList.innerHTML = `<li class="px-4 py-6 text-center text-sm text-slate-400">Aucun résultat pour « ${input.value} »</li>`;
    return;
  }
  if (!items.length) {
    resultsList.innerHTML = `<li class="px-4 py-6 text-center text-sm text-slate-400">Commencez à taper…</li>`;
    return;
  }
  resultsList.innerHTML = items.slice(0, 8).map(({ item }: any) => `
    <li>
      <a href="${item.url}" class="flex items-center gap-3 px-4 py-3 text-sm transition-colors hover:bg-gray-50">
        <span class="shrink-0 text-xl">${TYPE_ICON[item.type] ?? '📄'}</span>
        <div class="min-w-0 flex-1">
          <p class="truncate font-medium text-gray-900">${item.title}</p>
          <p class="truncate text-xs text-slate-400">${TYPE_LABEL[item.type]} · ${item.subtitle ?? ''}</p>
        </div>
      </a>
    </li>
  `).join('');
}

async function loadIndex() {
  try {
    // charger Fuse.js depuis CDN si pas encore disponible
    if (!(window as any).Fuse) {
      await new Promise<void>((resolve, reject) => {
        const s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/fuse.js@7.0.0/dist/fuse.min.js';
        s.onload = () => resolve();
        s.onerror = () => reject();
        document.head.appendChild(s);
      });
    }
    const res = await fetch('/search.json');
    const data = await res.json();
    fuseInstance = new (window as any).Fuse(data, {
      keys: ['title', 'subtitle', 'tags'],
      threshold: 0.35,
      includeScore: true,
    });
    indexLoaded = true;
  } catch {
    // silencieux si offline
  }
}

btn?.addEventListener('click', openModal);
backdrop?.addEventListener('click', closeModal);
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') closeModal();
  if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); openModal(); }
});
input?.addEventListener('input', () => {
  const q = input.value.trim();
  if (!q || !fuseInstance) { renderResults([]); return; }
  renderResults(fuseInstance.search(q));
});
</script>
