---
import Layout from '@/components/Layout.astro';
---

<Layout
  title="Mes races sauvegardées — PetScore™"
  description="Retrouvez toutes les races de chiens que vous avez sauvegardées sur PetScore™ pour les comparer facilement."
  canonicalUrl="/fr/favoris/"
>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">

    <nav aria-label="Fil d'Ariane" class="mb-8">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-slate-400">
        <li><a href="/fr/" class="hover:text-green-600 transition-colors">Accueil</a></li>
        <li aria-hidden="true"><svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></li>
        <li aria-current="page" class="font-medium text-gray-700">❤️ Mes favoris</li>
      </ol>
    </nav>

    <header class="mb-8">
      <h1 class="font-display text-3xl font-bold tracking-tight text-gray-900">
        ❤️ Mes races sauvegardées
      </h1>
      <p class="mt-2 text-slate-500">
        Retrouvez ici toutes les races que vous avez sauvegardées. Sauvegardées localement dans votre navigateur.
      </p>
    </header>

    <!-- Contenu chargé côté client -->
    <div id="favorites-root">
      <p class="text-slate-400 text-sm">Chargement de vos favoris…</p>
    </div>

    <div id="favorites-empty" class="hidden text-center py-12">
      <p class="text-5xl mb-4">🤍</p>
      <p class="font-display text-xl font-bold text-gray-900 mb-2">Aucun favori sauvegardé</p>
      <p class="text-slate-500 mb-6">Parcourez nos fiches races et cliquez sur le bouton "Sauvegarder" pour retrouver vos races préférées ici.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/fr/races/" class="rounded-full bg-green-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-green-700 transition-colors">Parcourir les races →</a>
        <a href="/fr/quiz/" class="rounded-full border border-gray-200 px-5 py-2.5 text-sm font-medium text-slate-600 hover:bg-gray-50 transition-colors">Faire le quiz →</a>
      </div>
    </div>

    <div id="favorites-grid" class="hidden grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>

    <div id="favorites-actions" class="hidden mt-6 flex flex-wrap gap-3">
      <a href="/fr/races/" class="rounded-full border border-gray-200 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-gray-50 transition-colors">Ajouter d'autres races →</a>
      <button id="clear-favorites" class="rounded-full border border-red-200 bg-red-50 px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-100 transition-colors">
        🗑️ Tout effacer
      </button>
    </div>

    <script type="module">
      const STORAGE_KEY = 'petscore_favorites';

      function getFavorites() {
        try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); }
        catch { return []; }
      }

      async function loadBreeds() {
        const res = await fetch('/api/breeds.json').catch(() => null);
        // Fallback: fetch the breeds from the static JSON
        const r2 = await fetch('/_data/breeds.json').catch(() => null);
        return null;
      }

      function renderFavorites() {
        const slugs = getFavorites();
        const root   = document.getElementById('favorites-root');
        const empty  = document.getElementById('favorites-empty');
        const grid   = document.getElementById('favorites-grid');
        const actions = document.getElementById('favorites-actions');

        if (root) root.classList.add('hidden');

        if (slugs.length === 0) {
          empty?.classList.remove('hidden');
          return;
        }

        // Build cards from slugs (link only — no JSON fetch needed)
        if (grid) {
          grid.classList.remove('hidden');
          grid.innerHTML = slugs.map((slug) => {
            const name = slug.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
            return `
              <a href="/fr/races/${slug}" class="group flex items-center gap-3 rounded-2xl border border-pink-100 bg-white p-4 shadow-sm transition-all duration-200 hover:shadow-md hover:-translate-y-0.5">
                <span class="text-3xl">❤️</span>
                <div class="min-w-0">
                  <p class="truncate font-semibold text-gray-900 group-hover:text-green-600 transition-colors">${name}</p>
                  <p class="text-xs text-slate-400">Voir la fiche →</p>
                </div>
              </a>`;
          }).join('');
          actions?.classList.remove('hidden');
        }
      }

      document.getElementById('clear-favorites')?.addEventListener('click', () => {
        localStorage.removeItem(STORAGE_KEY);
        renderFavorites();
      });

      renderFavorites();
    </script>
  </div>
</Layout>
