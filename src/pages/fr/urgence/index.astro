---
import Layout from '@/components/Layout.astro';
import EmergencyCalculator from '@/components/EmergencyCalculator.tsx';
---

<Layout
  title="Urgence vétérinaire chien — Mon chien doit-il aller aux urgences ? | PetScore™ Québec"
  description="Outil interactif : identifiez si les symptômes de votre chien nécessitent une urgence vétérinaire immédiate, une consultation aujourd'hui ou un simple suivi. Gratuit, sans inscription."
  canonicalUrl="/fr/urgence/"
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">

    <nav aria-label="Fil d'Ariane" class="mb-8">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-slate-400">
        <li><a href="/fr/" class="hover:text-green-600 transition-colors">Accueil</a></li>
        <li aria-hidden="true"><svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></li>
        <li aria-current="page" class="font-medium text-gray-700">Urgence vétérinaire</li>
      </ol>
    </nav>

    <header class="mb-8">
      <h1 class="font-display text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        🚨 Mon chien a besoin d'urgences ?
      </h1>
      <p class="mt-3 leading-relaxed text-slate-500">
        Cochez les symptômes que vous observez chez votre chien. L'outil évalue le niveau d'urgence et vous recommande
        l'action à prendre. Simple, rapide et sans inscription.
      </p>
      <div class="mt-4 rounded-2xl border border-amber-100 bg-amber-50 p-3 text-sm text-amber-800">
        ⚠️ En cas de doute, <strong>consultez toujours un vétérinaire</strong>. Cet outil est indicatif et ne remplace pas un diagnostic professionnel.
      </div>
    </header>

    <!-- Calculateur interactif -->
    <EmergencyCalculator client:load />

    <!-- Cliniques d'urgence québécoises -->
    <section class="mt-12">
      <h2 class="mb-4 font-display text-xl font-bold text-gray-900">
        🏥 Cliniques vétérinaires d'urgence au Québec
      </h2>
      <div class="grid gap-3 sm:grid-cols-2">
        {[
          { name: 'DMV Montréal (24h)',          city: 'Montréal',    phone: '514 633-8888',  note: 'Ouvert 24h/7j' },
          { name: 'CHUV Université de Montréal', city: 'Montréal',    phone: '514 343-6111',  note: 'Urgences spécialisées' },
          { name: 'Urgence Vét Rive-Sud',        city: 'Brossard',    phone: '450 444-0460',  note: 'Nuits et week-ends' },
          { name: 'Centre Vét Laval',            city: 'Laval',       phone: '450 629-4545',  note: 'Urgences disponibles' },
          { name: 'CHUV Québec',                 city: 'Québec',      phone: '418 656-2022',  note: 'Université Laval' },
          { name: 'Urgences Vétérinaires Est',   city: 'Sherbrooke',  phone: '819 823-3100',  note: 'Régional' },
        ].map(({ name, city, phone, note }) => (
          <div class="rounded-xl border border-gray-100 bg-white p-4 shadow-sm">
            <p class="font-semibold text-gray-900">{name}</p>
            <p class="text-xs text-slate-400">{city} · {note}</p>
            <a href={`tel:${phone.replace(/\s/g, '')}`}
              class="mt-2 inline-block text-sm font-bold text-green-600 hover:underline">
              📞 {phone}
            </a>
          </div>
        ))}
      </div>
      <p class="mt-4 text-xs text-slate-400">
        Ces informations sont fournies à titre indicatif. Vérifiez les horaires et disponibilités avant de vous déplacer.
      </p>
    </section>

    <!-- Lien blog conditions -->
    <div class="mt-10 rounded-2xl bg-gray-50 p-5 text-center">
      <p class="text-sm text-slate-500 mb-3">En savoir plus sur les maladies héréditaires</p>
      <div class="flex flex-wrap justify-center gap-2">
        <a href="/fr/conditions/" class="rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-slate-600 hover:bg-gray-100 transition-colors">Conditions médicales →</a>
        <a href="/fr/blog/maladies-hereditaires-races" class="rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-slate-600 hover:bg-gray-100 transition-colors">Article : maladies héréditaires →</a>
      </div>
    </div>
  </div>
</Layout>
