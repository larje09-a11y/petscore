---
import Layout from '@/components/Layout.astro';
import breedsRaw from '@/data/breeds.json';
import type { Breed } from '@/types/breed';
import { getScoreHex, getRiskBadgeClass, getRiskLabel } from '@/lib/breeds';

const breeds = (breedsRaw as Breed[]).sort((a, b) => a.popularityRank - b.popularityRank);

// Paires populaires mises en avant (top comparaisons)
const popularPairs: [string, string][] = [
  ['labrador-retriever',     'golden-retriever'],
  ['bouledogue-francais',    'carlin'],
  ['border-collie',          'berger-australien'],
  ['caniche',                'bichon-frise'],
  ['berger-allemand',        'berger-belge-malinois'],
  ['husky-siberien',         'malamute-alaska'],
  ['labrador-retriever',     'berger-allemand'],
  ['golden-retriever',       'bouvier-bernois'],
  ['yorkshire-terrier',      'chihuahua'],
  ['rottweiler',             'dobermann'],
  ['whippet',                'basenji'],
  ['jack-russell-terrier',   'west-highland-white-terrier'],
];

function findBreed(slug: string) {
  return breeds.find((b) => b.slug === slug)!;
}
---

<Layout
  title="Comparer les races de chiens — PetScore™"
  description="Comparez deux races de chiens côte à côte : PetScore™, santé, coûts vétérinaires, longévité et caractère. Trouvez la meilleure race pour vous au Québec."
  canonicalUrl="/fr/comparer/"
>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">

    <!-- Fil d'Ariane -->
    <nav aria-label="Fil d'Ariane" class="mb-8">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-slate-400">
        <li><a href="/fr/" class="hover:text-green-600 transition-colors">Accueil</a></li>
        <li aria-hidden="true">
          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </li>
        <li aria-current="page" class="font-medium text-gray-700">Comparer</li>
      </ol>
    </nav>

    <!-- En-tête -->
    <header class="mb-10 text-center">
      <h1 class="font-display text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        Comparez deux races
      </h1>
      <p class="mt-3 text-slate-500">
        Sélectionnez deux races pour voir leur comparaison détaillée : score santé, risques, coûts et caractère.
      </p>
    </header>

    <!-- Sélecteur interactif (vanilla JS) -->
    <div class="mb-12 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
      <div class="flex flex-col items-center gap-4 sm:flex-row">
        <select id="breed1" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm font-medium text-gray-700 outline-none focus:border-green-400 focus:ring-2 focus:ring-green-100">
          <option value="">Choisir la race 1…</option>
          {breeds.map((b) => (
            <option value={b.slug}>{b.name} ({b.score}/100)</option>
          ))}
        </select>

        <span class="shrink-0 font-display text-lg font-bold text-slate-300">VS</span>

        <select id="breed2" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm font-medium text-gray-700 outline-none focus:border-green-400 focus:ring-2 focus:ring-green-100">
          <option value="">Choisir la race 2…</option>
          {breeds.map((b) => (
            <option value={b.slug}>{b.name} ({b.score}/100)</option>
          ))}
        </select>

        <button
          id="compare-btn"
          type="button"
          class="w-full shrink-0 rounded-xl bg-green-600 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-green-700 sm:w-auto"
        >
          Comparer →
        </button>
      </div>
    </div>

    <!-- Comparaisons populaires -->
    <section>
      <h2 class="mb-6 font-display text-xl font-bold text-gray-900">
        Comparaisons populaires
      </h2>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {popularPairs.map(([slug1, slug2]) => {
          const b1 = findBreed(slug1);
          const b2 = findBreed(slug2);
          if (!b1 || !b2) return null;
          const hex1 = getScoreHex(b1.score);
          const hex2 = getScoreHex(b2.score);
          return (
            <a
              href={`/fr/comparer/${b1.slug}-vs-${b2.slug}`}
              class="flex items-center gap-3 rounded-2xl border border-gray-100 bg-white p-4 shadow-sm transition-all duration-200 hover:shadow-md hover:-translate-y-0.5"
            >
              <!-- Score 1 -->
              <span class="font-display text-lg font-extrabold" style={`color:${hex1}`}>
                {b1.score}
              </span>
              <div class="min-w-0 flex-1 text-center">
                <p class="truncate text-xs font-semibold text-gray-700">{b1.name}</p>
                <p class="my-1 font-display text-xs font-bold text-slate-300">VS</p>
                <p class="truncate text-xs font-semibold text-gray-700">{b2.name}</p>
              </div>
              <!-- Score 2 -->
              <span class="font-display text-lg font-extrabold" style={`color:${hex2}`}>
                {b2.score}
              </span>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Toutes les races -->
    <section class="mt-12">
      <h2 class="mb-6 font-display text-xl font-bold text-gray-900">
        Toutes les races disponibles
      </h2>
      <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {breeds.map((b) => (
          <div class="flex items-center justify-between rounded-xl border border-gray-100 bg-white px-4 py-2.5">
            <span class="text-sm font-medium text-gray-800">{b.name}</span>
            <span class={`rounded-full px-2 py-0.5 text-xs font-semibold ${getRiskBadgeClass(b.riskLevel)}`}>
              {b.score}/100
            </span>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

<script>
  const btn    = document.getElementById('compare-btn') as HTMLButtonElement;
  const sel1   = document.getElementById('breed1') as HTMLSelectElement;
  const sel2   = document.getElementById('breed2') as HTMLSelectElement;

  btn.addEventListener('click', () => {
    const s1 = sel1.value;
    const s2 = sel2.value;
    if (!s1 || !s2 || s1 === s2) {
      alert('Choisissez deux races différentes.');
      return;
    }
    window.location.href = `/fr/comparer/${s1}-vs-${s2}`;
  });
</script>
