---
import Layout from '@/components/Layout.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPathsOptions } from 'astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allPosts = await getCollection('blog');
  const sorted = allPosts.sort(
    (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
  );
  return paginate(sorted, { pageSize: 9 });
}

const { page } = Astro.props as { page: any };
const posts = page.data;

// Tag cloud — computed from all posts
const allPosts = await getCollection('blog');
const tagCounts: Record<string, number> = {};
for (const p of allPosts) {
  for (const tag of p.data.tags) {
    tagCounts[tag] = (tagCounts[tag] ?? 0) + 1;
  }
}
const topTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 16);

function formatDate(date: Date): string {
  return date.toLocaleDateString('fr-CA', { year: 'numeric', month: 'long', day: 'numeric' });
}

const isFirstPage = page.currentPage === 1;
const canonicalUrl = isFirstPage ? '/fr/blog/' : `/fr/blog/${page.currentPage}/`;
const title = isFirstPage
  ? "Blog santé canine — Conseils & guides pour propriétaires au Québec | PetScore™"
  : `Blog santé canine — Page ${page.currentPage} | PetScore™`;
const description = "Articles et guides pratiques sur la santé des chiens au Québec : budget, assurances, maladies héréditaires, choix de race et conseils vétérinaires.";

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://petscore.ca/fr/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://petscore.ca/fr/blog/" },
    ...(!isFirstPage ? [{ "@type": "ListItem", "position": 3, "name": `Page ${page.currentPage}`, "item": `https://petscore.ca/fr/blog/${page.currentPage}/` }] : []),
  ],
});
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={breadcrumbLd} />
    {page.url.prev && <link rel="prev" href={`https://petscore.ca${page.url.prev}`} />}
    {page.url.next && <link rel="next" href={`https://petscore.ca${page.url.next}`} />}
  </Fragment>

  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">

    <!-- Breadcrumb -->
    <nav aria-label="Fil d'Ariane" class="mb-8">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-slate-400">
        <li><a href="/fr/" class="hover:text-green-600 transition-colors">Accueil</a></li>
        <li aria-hidden="true"><svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></li>
        <li aria-current="page" class="font-medium text-gray-700">Blog{!isFirstPage && ` — Page ${page.currentPage}`}</li>
      </ol>
    </nav>

    <header class="mb-8">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 class="font-display text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
            📝 Blog santé canine
          </h1>
          <p class="mt-2 text-slate-500">
            {allPosts.length} articles · Guides, analyses et conseils pour propriétaires au Québec
          </p>
        </div>
        <a href="/rss.xml"
          class="flex items-center gap-1.5 rounded-xl border border-orange-200 bg-orange-50 px-3 py-1.5 text-xs font-semibold text-orange-600 transition hover:bg-orange-100"
          aria-label="Flux RSS">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
          </svg>
          RSS
        </a>
      </div>
    </header>

    <!-- Tag cloud -->
    <div class="mb-8 flex flex-wrap gap-2">
      {topTags.map(([tag, count]) => (
        <a
          href={`/fr/blog/tag/${tag}/`}
          class="rounded-full border border-gray-200 bg-white px-3 py-1 text-xs font-medium text-slate-600 transition hover:border-green-300 hover:text-green-700"
        >
          {tag} <span class="text-slate-300">({count})</span>
        </a>
      ))}
    </div>

    <!-- Article grid -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post: any) => (
        <article class="group flex flex-col rounded-2xl border border-gray-100 bg-white shadow-sm transition-all duration-200 hover:shadow-md hover:-translate-y-0.5 overflow-hidden">
          <a href={`/fr/blog/${post.slug}`} class="flex flex-col flex-1 p-5">
            <div class="mb-3 flex flex-wrap gap-1.5">
              {post.data.tags.slice(0, 2).map((tag: string) => (
                <span class="rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700">
                  {tag}
                </span>
              ))}
            </div>
            <h2 class="font-display text-base font-bold text-gray-900 group-hover:text-green-600 transition-colors leading-snug flex-1">
              {post.data.title}
            </h2>
            <p class="mt-2 text-xs leading-relaxed text-slate-500 line-clamp-3">
              {post.data.description}
            </p>
            <div class="mt-4 flex items-center justify-between border-t border-gray-50 pt-3">
              <span class="text-xs text-slate-400">
                {formatDate(post.data.publishedAt)}
              </span>
              <span class="text-xs font-semibold text-green-600 group-hover:underline">Lire →</span>
            </div>
          </a>
        </article>
      ))}
    </div>

    <!-- Pagination controls -->
    {page.lastPage > 1 && (
      <nav aria-label="Pagination" class="mt-10 flex flex-col items-center gap-3">
        <div class="flex items-center gap-2">
          {page.url.prev ? (
            <a href={page.url.prev}
              class="flex items-center gap-1.5 rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-slate-600 transition hover:border-green-300 hover:text-green-700">
              ← Précédent
            </a>
          ) : (
            <span class="flex items-center gap-1.5 rounded-xl border border-gray-100 bg-gray-50 px-4 py-2 text-sm font-semibold text-slate-300 cursor-not-allowed select-none">
              ← Précédent
            </span>
          )}

          <div class="flex items-center gap-1">
            {Array.from({ length: page.lastPage }, (_, i) => i + 1).map(n => (
              <a
                href={n === 1 ? '/fr/blog/' : `/fr/blog/${n}/`}
                class={`flex h-9 w-9 items-center justify-center rounded-lg text-sm font-semibold transition ${
                  n === page.currentPage
                    ? 'bg-green-600 text-white shadow-sm'
                    : 'border border-gray-200 bg-white text-slate-600 hover:border-green-300 hover:text-green-700'
                }`}
                aria-current={n === page.currentPage ? 'page' : undefined}
              >
                {n}
              </a>
            ))}
          </div>

          {page.url.next ? (
            <a href={page.url.next}
              class="flex items-center gap-1.5 rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-slate-600 transition hover:border-green-300 hover:text-green-700">
              Suivant →
            </a>
          ) : (
            <span class="flex items-center gap-1.5 rounded-xl border border-gray-100 bg-gray-50 px-4 py-2 text-sm font-semibold text-slate-300 cursor-not-allowed select-none">
              Suivant →
            </span>
          )}
        </div>
        <p class="text-xs text-slate-400">
          Page {page.currentPage} sur {page.lastPage} · {allPosts.length} articles au total
        </p>
      </nav>
    )}

    <!-- CTA Quiz -->
    <div class="mt-12 rounded-2xl bg-gradient-to-br from-green-50 to-white border border-green-100 p-6 text-center">
      <p class="font-display text-lg font-bold text-gray-900 mb-2">
        Trouvez votre race idéale en 3 minutes
      </p>
      <p class="text-sm text-slate-500 mb-4">
        Notre quiz analyse votre style de vie et vous recommande les races avec le meilleur PetScore™ pour vous.
      </p>
      <a href="/fr/quiz/" class="inline-block rounded-full bg-green-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-green-700 transition-colors">
        🐾 Faire le quiz gratuit
      </a>
    </div>
  </div>
</Layout>
