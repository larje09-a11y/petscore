---
import Layout from '@/components/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const tagSet = new Set<string>();
  for (const p of allPosts) {
    for (const tag of p.data.tags) tagSet.add(tag);
  }
  return [...tagSet].map(tag => ({
    params: { tag },
    props: {
      tag,
      posts: allPosts
        .filter(p => p.data.tags.includes(tag))
        .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()),
    },
  }));
}

export interface Props {
  tag: string;
  posts: Awaited<ReturnType<typeof getCollection<'blog'>>>;
}

const { tag, posts } = Astro.props;

function formatDate(date: Date): string {
  return date.toLocaleDateString('fr-CA', { year: 'numeric', month: 'long', day: 'numeric' });
}

// Collect related tags (tags that appear alongside this tag in posts)
const relatedTagCounts: Record<string, number> = {};
for (const p of posts) {
  for (const t of p.data.tags) {
    if (t !== tag) relatedTagCounts[t] = (relatedTagCounts[t] ?? 0) + 1;
  }
}
const relatedTags = Object.entries(relatedTagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8)
  .map(([t]) => t);

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://petscore.ca/fr/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://petscore.ca/fr/blog/" },
    { "@type": "ListItem", "position": 3, "name": `#${tag}`, "item": `https://petscore.ca/fr/blog/tag/${tag}/` },
  ],
});
---

<Layout
  title={`Articles sur "${tag}" — Blog PetScore™`}
  description={`${posts.length} article${posts.length > 1 ? 's' : ''} sur le sujet "${tag}" : conseils, guides et analyses pour propriétaires de chiens au Québec.`}
  canonicalUrl={`/fr/blog/tag/${tag}/`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={breadcrumbLd} />
  </Fragment>

  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6">

    <!-- Breadcrumb -->
    <nav aria-label="Fil d'Ariane" class="mb-8">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-slate-400">
        <li><a href="/fr/" class="hover:text-green-600 transition-colors">Accueil</a></li>
        <li aria-hidden="true"><svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></li>
        <li><a href="/fr/blog/" class="hover:text-green-600 transition-colors">Blog</a></li>
        <li aria-hidden="true"><svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></li>
        <li aria-current="page" class="font-medium text-gray-700">#{tag}</li>
      </ol>
    </nav>

    <!-- Header -->
    <header class="mb-10">
      <div class="mb-3 inline-flex items-center gap-2 rounded-full bg-green-100 px-4 py-1.5 text-sm font-semibold text-green-700">
        🏷️ {posts.length} article{posts.length > 1 ? 's' : ''}
      </div>
      <h1 class="font-display text-3xl font-bold tracking-tight text-gray-900">
        Articles : <span class="text-green-600">#{tag}</span>
      </h1>
      <p class="mt-2 text-slate-500">
        Tous nos articles sur le sujet « {tag} » pour les propriétaires de chiens au Québec.
      </p>
    </header>

    <!-- Related tags -->
    {relatedTags.length > 0 && (
      <div class="mb-8 flex flex-wrap gap-2 items-center">
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wide">Sujets liés :</span>
        {relatedTags.map(t => (
          <a href={`/fr/blog/tag/${t}/`}
            class="rounded-full border border-gray-200 bg-white px-3 py-1 text-xs font-medium text-slate-600 transition hover:border-green-300 hover:text-green-700">
            #{t}
          </a>
        ))}
      </div>
    )}

    <!-- Articles list -->
    <div class="space-y-5">
      {posts.map((post) => (
        <article class="group rounded-2xl border border-gray-100 bg-white p-5 shadow-sm transition-all duration-200 hover:shadow-md hover:-translate-y-0.5">
          <a href={`/fr/blog/${post.slug}`} class="block">
            <div class="mb-2 flex flex-wrap items-center gap-2">
              {post.data.tags.filter(t => t !== tag).slice(0, 2).map((t) => (
                <a href={`/fr/blog/tag/${t}/`}
                  class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-slate-500 hover:text-green-600 transition-colors"
                  onclick="event.stopPropagation()">
                  #{t}
                </a>
              ))}
            </div>
            <h2 class="font-display text-lg font-bold text-gray-900 group-hover:text-green-600 transition-colors leading-snug">
              {post.data.title}
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-slate-500 line-clamp-2">
              {post.data.description}
            </p>
            <div class="mt-3 flex items-center justify-between">
              <span class="text-xs text-slate-400">{formatDate(post.data.publishedAt)}</span>
              <span class="text-sm font-medium text-green-600 group-hover:underline">Lire →</span>
            </div>
          </a>
        </article>
      ))}
    </div>

    <!-- Back to blog -->
    <div class="mt-10 text-center">
      <a href="/fr/blog/" class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-600 transition hover:border-green-300 hover:text-green-700">
        ← Tous les articles du blog
      </a>
    </div>
  </div>
</Layout>
