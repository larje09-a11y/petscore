---
import Layout from '@/components/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

function formatDate(date: Date): string {
  return date.toLocaleDateString('fr-CA', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout
  title="Blog santé canine — Conseils & guides pour propriétaires au Québec | PetScore™"
  description="Articles et guides pratiques sur la santé des chiens au Québec : budget, assurances, maladies héréditaires, choix de race et conseils vétérinaires."
  canonicalUrl="/fr/blog/"
>
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6">

    <!-- Fil d'Ariane -->
    <nav aria-label="Fil d'Ariane" class="mb-8">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-slate-400">
        <li><a href="/fr/" class="hover:text-green-600 transition-colors">Accueil</a></li>
        <li aria-hidden="true"><svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></li>
        <li aria-current="page" class="font-medium text-gray-700">Blog</li>
      </ol>
    </nav>

    <header class="mb-10">
      <h1 class="font-display text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        📝 Blog santé canine
      </h1>
      <p class="mt-3 text-slate-500">
        Guides pratiques, analyses et conseils pour prendre les meilleures décisions pour la santé de votre chien au Québec.
      </p>
    </header>

    <div class="space-y-6">
      {posts.map((post) => (
        <article class="group rounded-2xl border border-gray-100 bg-white p-6 shadow-sm transition-all duration-200 hover:shadow-md hover:-translate-y-0.5">
          <a href={`/fr/blog/${post.slug}`} class="block">
            <div class="mb-2 flex flex-wrap items-center gap-2">
              {post.data.tags.slice(0, 3).map((tag) => (
                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-slate-500">
                  {tag}
                </span>
              ))}
              {post.data.readingTime && (
                <span class="text-xs text-slate-400">· {post.data.readingTime} min de lecture</span>
              )}
            </div>
            <h2 class="font-display text-xl font-bold text-gray-900 group-hover:text-green-600 transition-colors leading-snug">
              {post.data.title}
            </h2>
            <p class="mt-2 leading-relaxed text-slate-500 line-clamp-2">
              {post.data.description}
            </p>
            <div class="mt-4 flex items-center justify-between">
              <span class="text-xs text-slate-400">
                {formatDate(post.data.publishedAt)} · {post.data.author}
              </span>
              <span class="text-sm font-medium text-green-600 group-hover:underline">Lire →</span>
            </div>
          </a>
        </article>
      ))}
    </div>

    <!-- CTA Quiz -->
    <div class="mt-12 rounded-2xl bg-gradient-to-br from-green-50 to-white border border-green-100 p-6 text-center">
      <p class="font-display text-lg font-bold text-gray-900 mb-2">
        Trouvez votre race idéale en 3 minutes
      </p>
      <p class="text-sm text-slate-500 mb-4">
        Notre quiz analyse votre style de vie et vous recommande les races avec le meilleur PetScore™ pour vous.
      </p>
      <a href="/fr/quiz/" class="inline-block rounded-full bg-green-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-green-700 transition-colors">
        🐾 Faire le quiz gratuit
      </a>
    </div>
  </div>
</Layout>
