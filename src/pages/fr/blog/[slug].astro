---
import Layout from '@/components/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { articleJsonLd } from '@/lib/jsonld';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const jsonLd = articleJsonLd({
  title:       post.data.title,
  description: post.data.description,
  slug:        post.slug,
  publishedAt: post.data.publishedAt,
  updatedAt:   post.data.updatedAt,
  author:      post.data.author,
});

function formatDate(date: Date): string {
  return date.toLocaleDateString('fr-CA', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout
  title={`${post.data.title} | PetScore™`}
  description={post.data.description}
  canonicalUrl={`/fr/blog/${post.slug}`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd} />
  </Fragment>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">

    <!-- Fil d'Ariane -->
    <nav aria-label="Fil d'Ariane" class="mb-8">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-slate-400">
        <li><a href="/fr/" class="hover:text-green-600 transition-colors">Accueil</a></li>
        <li aria-hidden="true"><svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></li>
        <li><a href="/fr/blog/" class="hover:text-green-600 transition-colors">Blog</a></li>
        <li aria-hidden="true"><svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></li>
        <li aria-current="page" class="font-medium text-gray-700 truncate max-w-[14rem]">Article</li>
      </ol>
    </nav>

    <!-- En-tête article -->
    <header class="mb-8">
      <div class="mb-3 flex flex-wrap items-center gap-2">
        {post.data.tags.map((tag) => (
          <span class="rounded-full bg-gray-100 px-3 py-0.5 text-xs font-medium text-slate-500">
            {tag}
          </span>
        ))}
      </div>
      <h1 class="font-display text-3xl font-bold leading-tight tracking-tight text-gray-900 sm:text-4xl">
        {post.data.title}
      </h1>
      <div class="mt-4 flex flex-wrap items-center gap-4 text-sm text-slate-400">
        <span>✍️ {post.data.author}</span>
        <span>📅 {formatDate(post.data.publishedAt)}</span>
        {post.data.readingTime && <span>⏱️ {post.data.readingTime} min de lecture</span>}
        {post.data.updatedAt && (
          <span>🔄 Mis à jour le {formatDate(post.data.updatedAt)}</span>
        )}
      </div>
    </header>

    <!-- Contenu Markdown -->
    <div class="prose prose-slate max-w-none
      prose-headings:font-display prose-headings:font-bold prose-headings:tracking-tight
      prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
      prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
      prose-p:leading-relaxed prose-p:text-slate-600
      prose-a:text-green-600 prose-a:no-underline hover:prose-a:underline
      prose-strong:text-gray-800
      prose-ul:text-slate-600 prose-li:my-1
      prose-table:text-sm prose-th:text-gray-700 prose-td:text-slate-600
      prose-blockquote:border-green-400 prose-blockquote:text-slate-500
      prose-code:text-green-700 prose-code:bg-green-50 prose-code:rounded prose-code:px-1">
      <Content />
    </div>

    <!-- Footer article -->
    <footer class="mt-12 border-t border-gray-100 pt-6">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <a href="/fr/blog/" class="rounded-full border border-gray-200 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-gray-50 transition-colors">
          ← Retour au blog
        </a>
        <div class="flex gap-2">
          <a href="/fr/quiz/" class="rounded-full bg-green-600 px-4 py-2 text-sm font-semibold text-white hover:bg-green-700 transition-colors">
            🐾 Faire le quiz
          </a>
          <a href="/fr/races/" class="rounded-full border border-gray-200 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-gray-50 transition-colors">
            Toutes les races →
          </a>
        </div>
      </div>
    </footer>
  </div>
</Layout>
