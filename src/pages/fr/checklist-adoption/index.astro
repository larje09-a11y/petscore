---
import Layout from '@/components/Layout.astro';
import ChecklistAdoption from '@/components/ChecklistAdoption.tsx';

const title       = "Checklist adoption chien — 30 étapes avant, pendant et après | PetScore™";
const description = "Checklist complète pour adopter un chien au Québec : 30 étapes organisées en 5 phases (avant, jour J, semaine 1, premier mois, première année). Sauvegarde automatique.";

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "Comment adopter un chien au Québec : 30 étapes",
  "description": description,
  "url": "https://petscore.ca/fr/checklist-adoption/",
  "step": [
    { "@type": "HowToStep", "name": "Choisir sa race", "text": "Évaluer son style de vie et ses besoins pour choisir la race idéale." },
    { "@type": "HowToStep", "name": "Rechercher un éleveur ou un refuge", "text": "Trouver un éleveur certifié CKC ou un refuge fiable au Québec." },
    { "@type": "HowToStep", "name": "Préparer la maison", "text": "Sécuriser l'espace, acheter les équipements de base." },
    { "@type": "HowToStep", "name": "Première visite vétérinaire", "text": "Bilan de santé, vaccins, micropuce, inscription municipale." },
    { "@type": "HowToStep", "name": "Socialisation et éducation", "text": "Cours d'obéissance, rencontres avec d'autres chiens, habituation." },
  ],
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://petscore.ca/fr/" },
      { "@type": "ListItem", "position": 2, "name": "Checklist adoption", "item": "https://petscore.ca/fr/checklist-adoption/" }
    ]
  }
});
---

<Layout {title} {description} canonicalUrl="/fr/checklist-adoption/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd} />
    <style>
      @media print {
        nav, header nav, .no-print { display: none !important; }
        body { font-size: 12px; }
      }
    </style>
  </Fragment>

  <div class="mx-auto max-w-2xl px-4 py-10 sm:px-6">

    <!-- Fil d'Ariane -->
    <nav aria-label="Fil d'Ariane" class="mb-8 no-print">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-slate-400">
        <li><a href="/fr/" class="hover:text-green-600 transition-colors">Accueil</a></li>
        <li aria-hidden="true">
          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </li>
        <li aria-current="page" class="font-medium text-gray-700">Checklist adoption</li>
      </ol>
    </nav>

    <!-- En-tête -->
    <header class="mb-8">
      <h1 class="font-display text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        ✅ Checklist adoption chien
      </h1>
      <p class="mt-3 text-slate-500">
        30 étapes à cocher avant, pendant et après l'adoption.
        Votre progression est <strong>sauvegardée automatiquement</strong> dans votre navigateur.
      </p>
      <div class="mt-4 flex flex-wrap gap-2 no-print">
        <a href="/fr/guide-premier-chien/" class="inline-flex items-center gap-1.5 rounded-full border border-blue-200 bg-blue-50 px-3 py-1.5 text-xs font-semibold text-blue-700 hover:bg-blue-100 transition-colors">
          📖 Guide complet →
        </a>
        <a href="/fr/quiz/" class="inline-flex items-center gap-1.5 rounded-full border border-green-200 bg-green-50 px-3 py-1.5 text-xs font-semibold text-green-700 hover:bg-green-100 transition-colors">
          🐾 Trouver ma race →
        </a>
        <a href="/fr/races/prix-races-chiens" class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-gray-50 transition-colors">
          💰 Prix des races →
        </a>
      </div>
    </header>

    <!-- Composant React interactif -->
    <ChecklistAdoption client:load />

  </div>
</Layout>
