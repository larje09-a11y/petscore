---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildTitle } from '@/lib/seo';
import pagesData from '@/data/pages.fr.json';

export async function getStaticPaths() {
  // Source unique de données : src/data/pages.fr.json
  // À remplacer par un fetch API, une query DB, ou un CSV/CSV selon le projet
  return pagesData
    .filter((p) => p.lang === 'fr')
    .map((page) => ({
      params: { slug: page.slug },
      props: page,
    }));
}

interface Props {
  slug: string;
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = buildTitle(title);
---

<BaseLayout title={pageTitle} description={description} lang="fr">
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
      {title}
    </h1>
    <p class="mt-6 text-lg leading-8 text-gray-600">
      {description}
    </p>

    <!-- Contenu programmatique ici -->
    <slot />
  </article>
</BaseLayout>
