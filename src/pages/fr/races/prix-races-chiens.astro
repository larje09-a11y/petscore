---
import Layout from '@/components/Layout.astro';
import breedsRaw from '@/data/breeds.json';
import type { Breed } from '@/types/breed';
import { getScoreHex, getScoreDashArray } from '@/lib/breeds';
import { breedPurchasePrices, fmtPrice, totalCost10y } from '@/data/breedPrices';

const allBreeds = breedsRaw as Breed[];
const breeds = [...allBreeds].sort((a, b) => {
  const pa = breedPurchasePrices[a.slug];
  const pb = breedPurchasePrices[b.slug];
  if (!pa || !pb) return 0;
  return pa.min - pb.min || pa.max - pb.max;
});

const fmtCAD = (n: number) => `${new Intl.NumberFormat("fr-CA").format(n)} $`;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Prix d'achat moyen des races de chiens au Québec",
  "description": "Tableau des prix d'achat moyens pour toutes les races de chiens au Québec en 2026.",
  "numberOfItems": breeds.length,
  "itemListElement": breeds.map((b, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": b.name,
    "url": `https://petscore.ca/fr/races/${b.slug}`,
  })),
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://petscore.ca/fr/" },
      { "@type": "ListItem", "position": 2, "name": "Races", "item": "https://petscore.ca/fr/races/" },
      { "@type": "ListItem", "position": 3, "name": "Prix races chiens", "item": "https://petscore.ca/fr/races/prix-races-chiens" }
    ]
  }
});
---

<Layout
  title="Prix d'achat moyen des races de chiens au Québec 2026 — PetScore™"
  description="Combien coûte un chien au Québec ? Prix d'achat moyen de toutes les races + coût total sur 10 ans (vétérinaire inclus). Mis à jour 2026."
  canonicalUrl="/fr/races/prix-races-chiens"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">

    <!-- Fil d'Ariane -->
    <nav aria-label="Fil d'Ariane" class="mb-8">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-slate-400">
        <li><a href="/fr/" class="hover:text-green-600 transition-colors">Accueil</a></li>
        <li aria-hidden="true"><svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></li>
        <li><a href="/fr/races/" class="hover:text-green-600 transition-colors">Races</a></li>
        <li aria-hidden="true"><svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></li>
        <li aria-current="page" class="font-medium text-gray-700">Prix des races</li>
      </ol>
    </nav>

    <!-- En-tête -->
    <header class="mb-10">
      <h1 class="font-display text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        💰 Prix d'achat des races de chiens au Québec
      </h1>
      <p class="mt-3 max-w-2xl text-slate-500">
        Estimations basées sur les annonces d'éleveurs certifiés CKC au Québec et au Canada (2024–2026).
        Le coût total sur 10 ans inclut le prix d'achat + les frais vétérinaires estimés.
      </p>
      <div class="mt-4 inline-flex items-start gap-2 rounded-xl bg-amber-50 border border-amber-100 px-4 py-3 text-sm text-amber-800">
        <span class="shrink-0">⚠️</span>
        <span>
          Ces prix sont indicatifs. Les prix réels varient selon l'éleveur, la lignée, les tests génétiques effectués
          et la localisation. Un chien pas cher chez un éleveur non certifié peut coûter
          <strong> bien plus cher en frais vétérinaires</strong>.
        </span>
      </div>
    </header>

    <!-- Stats rapides -->
    <div class="mb-10 grid gap-4 sm:grid-cols-3">
      {(() => {
        const prices = Object.values(breedPurchasePrices);
        const minPrice = Math.min(...prices.map(p => p.min));
        const maxPrice = Math.max(...prices.map(p => p.max));
        const avg = Math.round(prices.reduce((s, p) => s + (p.min + p.max) / 2, 0) / prices.length);
        return [
          { label: "Prix le plus bas", value: fmtCAD(minPrice), sub: "Jack Russell Terrier", icon: "📉" },
          { label: "Prix moyen", value: fmtCAD(avg), sub: "Toutes races confondues", icon: "📊" },
          { label: "Prix le plus élevé", value: fmtCAD(maxPrice), sub: "Races brachycéphales", icon: "📈" },
        ].map(({ label, value, sub, icon }) => (
          <div class="rounded-2xl border border-gray-100 bg-white p-5 text-center shadow-sm">
            <span class="text-2xl">{icon}</span>
            <p class="mt-1 font-display text-xl font-bold text-gray-900">{value}</p>
            <p class="text-xs font-semibold text-slate-500">{label}</p>
            <p class="text-xs text-slate-400">{sub}</p>
          </div>
        ));
      })()}
    </div>

    <!-- Tableau complet -->
    <section class="overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm">
      <div class="border-b border-gray-100 px-6 py-4">
        <h2 class="font-display text-lg font-bold text-gray-900">Toutes les races — prix et coût total 10 ans</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-100 bg-gray-50 text-left">
              <th class="px-4 py-3 font-semibold text-gray-700">Race</th>
              <th class="px-4 py-3 font-semibold text-gray-700 text-right">Prix d'achat</th>
              <th class="px-4 py-3 font-semibold text-gray-700 text-right hidden sm:table-cell">Vét. / an (max)</th>
              <th class="px-4 py-3 font-semibold text-gray-700 text-right">Total 10 ans</th>
              <th class="px-4 py-3 font-semibold text-gray-700 text-center">Score</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50">
            {breeds.map((breed) => {
              const price = breedPurchasePrices[breed.slug];
              if (!price) return null;
              const { total } = totalCost10y(breed.slug, breed.annualVetCost.max);
              const hex  = getScoreHex(breed.score);
              return (
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-4 py-3">
                    <a href={`/fr/races/${breed.slug}`} class="flex items-center gap-2 font-semibold text-gray-800 hover:text-green-600 transition-colors">
                      <span class="text-xs text-slate-400 capitalize hidden sm:inline">{breed.size}</span>
                      {breed.name}
                    </a>
                  </td>
                  <td class="px-4 py-3 text-right text-green-700 font-semibold">
                    {fmtCAD(price.min)}–{fmtCAD(price.max)}
                  </td>
                  <td class="px-4 py-3 text-right text-slate-600 hidden sm:table-cell">
                    {fmtCAD(breed.annualVetCost.max)}
                  </td>
                  <td class="px-4 py-3 text-right font-bold" style={`color:${hex}`}>
                    {fmtCAD(total)}
                  </td>
                  <td class="px-4 py-3 text-center">
                    <span class="font-bold text-sm" style={`color:${hex}`}>{breed.score}</span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="px-5 py-3 text-xs text-slate-400 border-t border-gray-100">
        * Coût total 10 ans = prix d'achat (max) + frais vétérinaires annuels (max) × 10. Excluent nourriture, toilettage, assurance et accessoires.
      </p>
    </section>

    <!-- Conseil achat vs adoption -->
    <section class="mt-10 grid gap-4 sm:grid-cols-2">
      <div class="rounded-2xl border border-blue-100 bg-blue-50 p-5">
        <h2 class="mb-3 font-display text-base font-bold text-gray-900">🐕 Acheter chez un éleveur certifié</h2>
        <ul class="space-y-2 text-sm text-slate-600">
          <li class="flex items-start gap-2"><span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500"></span>Tests génétiques OFA effectués sur les parents</li>
          <li class="flex items-start gap-2"><span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500"></span>Garantie santé contractuelle (souvent 2 ans)</li>
          <li class="flex items-start gap-2"><span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500"></span>Socialisation contrôlée dès la naissance</li>
          <li class="flex items-start gap-2"><span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500"></span>Suivi post-vente par l'éleveur</li>
        </ul>
        <p class="mt-3 text-xs text-blue-700 font-medium">Chercher les membres du Club Canin Canadien (CKC)</p>
      </div>

      <div class="rounded-2xl border border-green-100 bg-green-50 p-5">
        <h2 class="mb-3 font-display text-base font-bold text-gray-900">❤️ Adopter dans un refuge</h2>
        <ul class="space-y-2 text-sm text-slate-600">
          <li class="flex items-start gap-2"><span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-green-500"></span>Frais d'adoption : 100–450 $ (stérilisation souvent incluse)</li>
          <li class="flex items-start gap-2"><span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-green-500"></span>Chiens souvent vaccinés et micropucés</li>
          <li class="flex items-start gap-2"><span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-green-500"></span>Acte éthique — sauver un animal dans le besoin</li>
          <li class="flex items-start gap-2"><span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-green-500"></span>SPCA Montréal, SSPCA, refuges municipaux</li>
        </ul>
        <p class="mt-3 text-xs text-green-700 font-medium">Économies possibles : 1 000–5 000 $ vs achat chez éleveur</p>
      </div>
    </section>

    <!-- CTAs -->
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/fr/races/races-moins-cheres" class="rounded-full border border-gray-200 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-gray-50 transition-colors">Races moins chères à entretenir →</a>
      <a href="/fr/assurance/" class="rounded-full border border-gray-200 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-gray-50 transition-colors">Comparer assurances →</a>
      <a href="/fr/checklist-adoption/" class="rounded-full border border-gray-200 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-gray-50 transition-colors">Checklist adoption →</a>
      <a href="/fr/quiz/" class="rounded-full bg-green-600 px-4 py-2 text-sm font-semibold text-white hover:bg-green-700 transition-colors">🐾 Trouver ma race idéale</a>
    </div>

  </div>
</Layout>
