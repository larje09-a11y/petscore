---
import Layout from '@/components/Layout.astro';
import breedsRaw from '@/data/breeds.json';
import type { Breed } from '@/types/breed';
import { getScoreHex, getScoreDashArray, getRiskBadgeClass, getRiskLabel } from '@/lib/breeds';

const allBreeds = breedsRaw as Breed[];
// Sort by lowest annual vet cost max, then by score desc
const breeds = [...allBreeds]
  .sort((a, b) => a.annualVetCost.max - b.annualVetCost.max || b.score - a.score)
  .slice(0, 15);

const fmtCAD = (n: number) => `${new Intl.NumberFormat("fr-CA").format(n)} $`;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Races de chiens les moins chères à entretenir au Québec",
  "description": "Top 15 des races de chiens avec les coûts vétérinaires annuels les plus bas au Québec.",
  "numberOfItems": breeds.length,
  "itemListElement": breeds.map((b, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": b.name,
    "url": `https://petscore.ca/fr/races/${b.slug}`,
  })),
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://petscore.ca/fr/" },
      { "@type": "ListItem", "position": 2, "name": "Races", "item": "https://petscore.ca/fr/races/" },
      { "@type": "ListItem", "position": 3, "name": "Races moins chères", "item": "https://petscore.ca/fr/races/races-moins-cheres" }
    ]
  }
});
---

<Layout
  title="Top 15 races de chiens les moins chères à entretenir — Québec 2026"
  description={`Découvrez les ${breeds.length} races de chiens avec les coûts vétérinaires les plus bas au Québec. Économisez sur votre budget annuel sans sacrifier la santé de votre chien.`}
  canonicalUrl="/fr/races/races-moins-cheres"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">

    <!-- Fil d'Ariane -->
    <nav aria-label="Fil d'Ariane" class="mb-8">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-slate-400">
        <li><a href="/fr/" class="hover:text-green-600 transition-colors">Accueil</a></li>
        <li aria-hidden="true"><svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></li>
        <li><a href="/fr/races/" class="hover:text-green-600 transition-colors">Races</a></li>
        <li aria-hidden="true"><svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></li>
        <li aria-current="page" class="font-medium text-gray-700">Races moins chères</li>
      </ol>
    </nav>

    <!-- En-tête -->
    <header class="mb-10">
      <h1 class="font-display text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        💰 Top {breeds.length} races les moins chères à entretenir
      </h1>
      <p class="mt-3 max-w-2xl text-slate-500">
        Classement basé sur les coûts vétérinaires annuels estimés au Québec (consultations, soins préventifs
        et traitements des conditions courantes). Idéal si votre budget est votre premier critère.
      </p>
      <!-- Info bulle budget -->
      <div class="mt-4 inline-flex items-start gap-2 rounded-xl bg-blue-50 border border-blue-100 px-4 py-3 text-sm text-blue-700">
        <span class="shrink-0 text-base">ℹ️</span>
        <span>
          Les coûts incluent : visites annuelles, vaccins, vermifugation, soins dentaires de base
          et traitements des maladies courantes de la race. Ils excluent les urgences et la chirurgie.
        </span>
      </div>
    </header>

    <!-- Grille des races -->
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {breeds.map((breed, i) => {
        const hex  = getScoreHex(breed.score);
        const dash = getScoreDashArray(breed.score);
        return (
          <a
            href={`/fr/races/${breed.slug}`}
            class="group relative flex items-center gap-4 rounded-2xl border border-gray-100 bg-white p-4 shadow-sm transition-all duration-200 hover:shadow-md hover:-translate-y-0.5"
          >
            {/* Badge de classement */}
            {i < 3 && (
              <span class="absolute -top-2 -left-2 flex h-7 w-7 items-center justify-center rounded-full bg-yellow-400 text-sm font-bold text-white shadow">
                {i === 0 ? "🥇" : i === 1 ? "🥈" : "🥉"}
              </span>
            )}

            {/* Score ring */}
            <svg viewBox="0 0 100 100" class="h-14 w-14 shrink-0" aria-hidden="true">
              <circle cx="50" cy="50" r="44" fill="none" stroke="#e5e7eb" stroke-width="11" />
              <circle cx="50" cy="50" r="44" fill="none" stroke={hex} stroke-width="11"
                stroke-dasharray={dash} stroke-linecap="round" transform="rotate(-90 50 50)" />
              <text x="50" y="50" text-anchor="middle" dominant-baseline="middle"
                font-size="28" font-weight="700" fill={hex} font-family="Sora, sans-serif">{breed.score}</text>
            </svg>

            <div class="min-w-0 flex-1">
              <p class="truncate font-display font-semibold text-gray-900 group-hover:text-green-600 transition-colors">
                {breed.name}
              </p>
              <p class="text-xs text-slate-400 capitalize">{breed.size} · {breed.origin}</p>
              <span class={`mt-1 inline-block rounded-full px-2 py-0.5 text-xs font-medium ${getRiskBadgeClass(breed.riskLevel)}`}>
                {getRiskLabel(breed.riskLevel)}
              </span>
              {/* Coût annuel — info clé */}
              <div class="mt-2 flex items-center gap-1.5 rounded-lg bg-green-50 px-2 py-1">
                <span class="text-green-600">💵</span>
                <span class="text-xs font-semibold text-green-700">
                  {fmtCAD(breed.annualVetCost.min)} – {fmtCAD(breed.annualVetCost.max)} / an
                </span>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Tableau comparatif détaillé -->
    <section class="mt-12 overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm">
      <div class="border-b border-gray-100 px-6 py-4">
        <h2 class="font-display text-lg font-bold text-gray-900">Tableau comparatif des coûts</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-100 bg-gray-50 text-left">
              <th class="px-4 py-3 font-semibold text-gray-700">#</th>
              <th class="px-4 py-3 font-semibold text-gray-700">Race</th>
              <th class="px-4 py-3 font-semibold text-gray-700 text-right">Vétérinaire / an</th>
              <th class="px-4 py-3 font-semibold text-gray-700 text-right">Assurance / mois</th>
              <th class="px-4 py-3 font-semibold text-gray-700 text-right">Total 10 ans (max)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50">
            {breeds.slice(0, 10).map((breed, i) => (
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-4 py-3 text-slate-400 font-medium">{i + 1}</td>
                <td class="px-4 py-3">
                  <a href={`/fr/races/${breed.slug}`} class="font-semibold text-gray-800 hover:text-green-600 transition-colors">
                    {breed.name}
                  </a>
                </td>
                <td class="px-4 py-3 text-right text-green-700 font-semibold">
                  {fmtCAD(breed.annualVetCost.min)}–{fmtCAD(breed.annualVetCost.max)}
                </td>
                <td class="px-4 py-3 text-right text-slate-600">
                  {breed.insuranceMonthly.min}–{breed.insuranceMonthly.max} $
                </td>
                <td class="px-4 py-3 text-right font-bold text-gray-800">
                  {fmtCAD(breed.annualVetCost.max * 10)}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Conseil budget -->
    <div class="mt-8 rounded-2xl bg-amber-50 border border-amber-100 p-6">
      <h2 class="mb-3 font-display text-lg font-bold text-gray-900">💡 Conseils pour réduire les coûts vétérinaires</h2>
      <ul class="space-y-2 text-sm text-slate-600">
        <li class="flex items-start gap-2">
          <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500"></span>
          <span><strong class="text-gray-800">Assurance dès le premier jour</strong> — souscrire avant l'apparition de conditions préexistantes réduit le coût total sur 10 ans de 30 à 60 %.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500"></span>
          <span><strong class="text-gray-800">Prévention plutôt que traitement</strong> — les visites annuelles de routine détectent les problèmes tôt, avant qu'ils ne deviennent coûteux.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500"></span>
          <span><strong class="text-gray-800">Éleveur certifié</strong> — un chiot issu d'une lignée testée génétiquement coûte plus cher à l'achat mais bien moins en frais vétérinaires.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500"></span>
          <span><strong class="text-gray-800">Cliniques universitaires</strong> — la Faculté de médecine vétérinaire de l'Université de Montréal propose des tarifs réduits pour certains soins.</span>
        </li>
      </ul>
    </div>

    <!-- Liens vers pages connexes -->
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/fr/races/races-longue-vie" class="rounded-full border border-gray-200 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-gray-50 transition-colors">Races longue vie →</a>
      <a href="/fr/races/meilleur-rapport-qualite-prix" class="rounded-full border border-gray-200 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-gray-50 transition-colors">Meilleur rapport qualité-prix →</a>
      <a href="/fr/assurance/" class="rounded-full border border-gray-200 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-gray-50 transition-colors">Comparateur assurances →</a>
      <a href="/fr/quiz/" class="rounded-full bg-green-600 px-4 py-2 text-sm font-semibold text-white hover:bg-green-700 transition-colors">🐾 Quiz personnalisé</a>
    </div>

  </div>
</Layout>
