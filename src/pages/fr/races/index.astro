---
import Layout from '@/components/Layout.astro';
import BreedSearch from '@/components/BreedSearch.tsx';
import breedsRaw from '@/data/breeds.json';
import type { Breed } from '@/types/breed';

const breeds = (breedsRaw as Breed[]).sort((a, b) => a.popularityRank - b.popularityRank);
---

<Layout
  title="Toutes les races de chiens — PetScore™"
  description="Comparez le PetScore™ de 50+ races de chiens et estimez vos coûts vétérinaires au Québec. Filtrez par taille, niveau de risque et niveau d'énergie."
  canonicalUrl="/fr/races/"
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <!-- En-tête -->
    <div class="mb-10 text-center">
      <h1 class="font-display text-4xl font-bold tracking-tight text-gray-900">
        Toutes les races
      </h1>
      <p class="mt-3 text-lg text-slate-500">
        {breeds.length} races analysées · Score de santé prédictif · Filtres et recherche
      </p>
    </div>

    <!-- Recherche + filtres + grille (React interactif) -->
    <BreedSearch client:load breeds={breeds} />
  </div>
</Layout>
