---
import Layout from '@/components/Layout.astro';
import breedsRaw from '@/data/breeds.json';
import type { Breed } from '@/types/breed';
import { getScoreHex, getScoreDashArray, getRiskLabel, getRiskBadgeClass } from '@/lib/breeds';

const breeds = (breedsRaw as Breed[]).sort((a, b) => a.popularityRank - b.popularityRank);
---

<Layout
  title="Toutes les races de chiens — PetScore™"
  description="Comparez le PetScore™ de 50+ races de chiens et estimez vos coûts vétérinaires au Québec."
  canonicalUrl="/fr/races/"
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <!-- En-tête -->
    <div class="mb-10 text-center">
      <h1 class="font-display text-4xl font-bold tracking-tight text-gray-900">
        Toutes les races
      </h1>
      <p class="mt-3 text-lg text-slate-500">
        {breeds.length} races analysées · Score de santé prédictif au Québec
      </p>
    </div>

    <!-- Grille -->
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {breeds.map((breed) => {
        const hex = getScoreHex(breed.score);
        const dash = getScoreDashArray(breed.score);
        return (
          <a
            href={`/fr/races/${breed.slug}`}
            class="group flex items-center gap-4 rounded-2xl border border-gray-100 bg-white p-4 shadow-sm transition-all duration-200 hover:shadow-md hover:-translate-y-0.5"
          >
            <!-- Mini score ring -->
            <svg viewBox="0 0 100 100" class="h-14 w-14 shrink-0" aria-hidden="true">
              <circle cx="50" cy="50" r="44" fill="none" stroke="#e5e7eb" stroke-width="10" />
              <circle cx="50" cy="50" r="44" fill="none" stroke={hex} stroke-width="10"
                stroke-dasharray={dash} stroke-linecap="round" transform="rotate(-90 50 50)" />
              <text x="50" y="50" text-anchor="middle" dominant-baseline="middle"
                font-size="26" font-weight="700" fill={hex} font-family="Sora, sans-serif">
                {breed.score}
              </text>
            </svg>

            <div class="min-w-0">
              <p class="font-display font-semibold text-gray-900 group-hover:text-green-600 transition-colors duration-200 truncate">
                {breed.name}
              </p>
              <p class="mt-0.5 text-xs text-slate-400 capitalize">{breed.size} · {breed.origin}</p>
              <span class={`mt-1.5 inline-block rounded-full px-2.5 py-0.5 text-xs font-medium ${getRiskBadgeClass(breed.riskLevel)}`}>
                {getRiskLabel(breed.riskLevel)}
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</Layout>
