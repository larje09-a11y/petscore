---
import Layout from '@/components/Layout.astro';
import breedsRaw from '@/data/breeds.json';
import type { Breed } from '@/types/breed';
import { getScoreHex, getScoreDashArray, getRiskBadgeClass, getRiskLabel } from '@/lib/breeds';

const allBreeds = breedsRaw as Breed[];
const breeds = allBreeds
  .filter((b) => b.traits.trainability >= 4)
  .sort((a, b) => b.traits.trainability - a.traits.trainability || b.score - a.score);

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Quelles sont les races de chiens les plus intelligentes ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Les races de chiens considérées comme les plus intelligentes selon Stanley Coren incluent le Border Collie, le Caniche, le Berger Allemand, le Golden Retriever et le Berger Australien. Ces races apprennent de nouveaux commandements en moins de 5 répétitions et obéissent au premier commandement dans plus de 95% des cas."
      }
    },
    {
      "@type": "Question",
      "name": "Un chien intelligent est-il plus facile à éduquer ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Pas nécessairement. Un chien très intelligent peut aussi être plus têtu, s'ennuyer plus vite et développer des comportements problématiques s'il n'est pas suffisamment stimulé mentalement. Les races très intelligentes comme le Border Collie sont souvent déconseillées aux débutants pour cette raison."
      }
    }
  ]
});
---

<Layout
  title="Races de chiens les plus intelligentes — Classement PetScore™ Québec"
  description={`Les ${breeds.length} races de chiens les plus intelligentes et les plus faciles à dresser au Québec. Classées par trainabilité et PetScore™ santé.`}
  canonicalUrl="/fr/races/races-intelligentes"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <nav aria-label="Fil d'Ariane" class="mb-8">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-slate-400">
        <li><a href="/fr/" class="hover:text-green-600 transition-colors">Accueil</a></li>
        <li aria-hidden="true"><svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></li>
        <li><a href="/fr/races/" class="hover:text-green-600 transition-colors">Races</a></li>
        <li aria-hidden="true"><svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></li>
        <li aria-current="page" class="font-medium text-gray-700">Races intelligentes</li>
      </ol>
    </nav>

    <header class="mb-10">
      <div class="mb-3 inline-flex items-center gap-2 rounded-full bg-purple-50 px-4 py-1.5 text-sm font-medium text-purple-700">
        🧠 Trainabilité 4–5 / 5
      </div>
      <h1 class="font-display text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        Races de chiens les plus intelligentes
      </h1>
      <p class="mt-3 max-w-2xl text-slate-500">
        Ces races se démarquent par leur capacité d'apprentissage rapide et leur réactivité aux commandements.
        Classées par score de trainabilité (4–5/5) avec leur PetScore™ santé.
      </p>
    </header>

    <!-- Avertissement débutants -->
    <div class="mb-8 rounded-2xl border border-purple-200 bg-purple-50 p-4 text-sm text-purple-800">
      <strong>⚠️ Attention si débutant :</strong> Les races très intelligentes ont aussi besoin de plus de stimulation mentale. Sans suffisamment d'exercice et de travail, elles peuvent développer des comportements indésirables (destruction, fugue, aboiements). Consultez notre <a href="/fr/quiz/" class="underline font-semibold">quiz personnalisé</a> pour vérifier la compatibilité.
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {breeds.map((breed, i) => {
        const hex  = getScoreHex(breed.score);
        const dash = getScoreDashArray(breed.score);
        return (
          <a href={`/fr/races/${breed.slug}`}
            class="group relative flex items-center gap-3 rounded-2xl border border-gray-100 bg-white p-4 shadow-sm transition-all duration-200 hover:shadow-md hover:-translate-y-0.5">
            {i < 3 && (
              <span class="absolute -top-2 -left-2 flex h-7 w-7 items-center justify-center rounded-full bg-purple-500 text-sm font-bold text-white shadow">
                {i === 0 ? '🥇' : i === 1 ? '🥈' : '🥉'}
              </span>
            )}
            <svg viewBox="0 0 100 100" class="h-14 w-14 shrink-0" aria-hidden="true">
              <circle cx="50" cy="50" r="44" fill="none" stroke="#e5e7eb" stroke-width="11" />
              <circle cx="50" cy="50" r="44" fill="none" stroke={hex} stroke-width="11"
                stroke-dasharray={dash} stroke-linecap="round" transform="rotate(-90 50 50)" />
              <text x="50" y="50" text-anchor="middle" dominant-baseline="middle"
                font-size="28" font-weight="700" fill={hex} font-family="Sora, sans-serif">{breed.score}</text>
            </svg>
            <div class="min-w-0">
              <p class="truncate font-display font-semibold text-gray-900 group-hover:text-green-600 transition-colors">{breed.name}</p>
              <p class="text-xs text-slate-400 capitalize">{breed.size} · {breed.origin}</p>
              <div class="mt-1 flex items-center gap-1">
                <span class="text-xs text-slate-400">QI :</span>
                {[1,2,3,4,5].map((dot) => (
                  <span class={`h-1.5 w-3 rounded-full ${dot <= breed.traits.trainability ? 'bg-purple-500' : 'bg-gray-100'}`} />
                ))}
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <!-- FAQ -->
    <div class="mt-12 space-y-4">
      <h2 class="font-display text-xl font-bold text-gray-900">Questions fréquentes</h2>
      <div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm">
        <h3 class="font-semibold text-gray-900">Le Border Collie est-il vraiment le chien le plus intelligent ?</h3>
        <p class="mt-2 text-sm text-slate-600">Selon Stanley Coren dans "The Intelligence of Dogs", le Border Collie occupe la première place. Il apprend un nouveau commandement en moins de 5 répétitions. Cependant, cette race nécessite un investissement en temps et en stimulation mentale considérable — elle n'est pas recommandée pour les familles peu actives.</p>
      </div>
      <div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm">
        <h3 class="font-semibold text-gray-900">Quelle race intelligente est bonne pour les débutants ?</h3>
        <p class="mt-2 text-sm text-slate-600">Parmi les races intelligentes et adaptées aux débutants, le Golden Retriever et le Labrador Retriever sont les meilleurs choix. Ils ont une trainabilité de 4-5/5, un caractère docile et patient, et une bonne tolérance aux erreurs d'éducation.</p>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href="/fr/pour/debutants/" class="rounded-full border border-gray-200 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-gray-50 transition-colors">Races pour débutants →</a>
      <a href="/fr/races/top-debutants" class="rounded-full border border-gray-200 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-gray-50 transition-colors">Top débutants →</a>
      <a href="/fr/quiz/" class="rounded-full bg-green-600 px-4 py-2 text-sm font-semibold text-white hover:bg-green-700 transition-colors">🐾 Quiz personnalisé</a>
    </div>
  </div>
</Layout>
