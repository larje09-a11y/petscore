---
import Layout from '@/components/Layout.astro';
import breedsRaw from '@/data/breeds.json';
import type { Breed } from '@/types/breed';
import { getScoreHex, getScoreDashArray, getRiskLabel, getRiskBadgeClass } from '@/lib/breeds';

const breeds = (breedsRaw as Breed[])
  .filter((b) => b.riskLevel === 'faible')
  .sort((a, b) => b.score - a.score);
---

<Layout
  title="Races de chiens à faible risque santé — PetScore™ Québec"
  description={`${breeds.length} races de chiens à faible risque héréditaire et PetScore™ élevé. Moins de frais vétérinaires imprévus au Québec.`}
  canonicalUrl="/fr/races/faible-risque"
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <nav aria-label="Fil d'Ariane" class="mb-8">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-slate-400">
        <li><a href="/fr/" class="hover:text-green-600 transition-colors">Accueil</a></li>
        <li aria-hidden="true"><svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></li>
        <li><a href="/fr/races/" class="hover:text-green-600 transition-colors">Races</a></li>
        <li aria-hidden="true"><svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></li>
        <li aria-current="page" class="font-medium text-gray-700">Faible risque</li>
      </ol>
    </nav>

    <header class="mb-10">
      <h1 class="font-display text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        ✅ Races à faible risque santé
      </h1>
      <p class="mt-3 text-slate-500 max-w-2xl">
        {breeds.length} races avec un PetScore™ élevé et peu de maladies héréditaires graves. Idéales si vous voulez limiter les dépenses vétérinaires imprévues.
      </p>
    </header>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {breeds.map((breed) => {
        const hex  = getScoreHex(breed.score);
        const dash = getScoreDashArray(breed.score);
        return (
          <a href={`/fr/races/${breed.slug}`}
            class="group flex items-center gap-3 rounded-2xl border border-green-100 bg-white p-4 shadow-sm transition-all duration-200 hover:shadow-md hover:-translate-y-0.5">
            <svg viewBox="0 0 100 100" class="h-14 w-14 shrink-0" aria-hidden="true">
              <circle cx="50" cy="50" r="44" fill="none" stroke="#e5e7eb" stroke-width="11" />
              <circle cx="50" cy="50" r="44" fill="none" stroke={hex} stroke-width="11"
                stroke-dasharray={dash} stroke-linecap="round" transform="rotate(-90 50 50)" />
              <text x="50" y="50" text-anchor="middle" dominant-baseline="middle"
                font-size="28" font-weight="700" fill={hex} font-family="Sora, sans-serif">{breed.score}</text>
            </svg>
            <div class="min-w-0">
              <p class="truncate font-display font-semibold text-gray-900 group-hover:text-green-600 transition-colors">{breed.name}</p>
              <p class="text-xs text-slate-400 capitalize">{breed.size} · {breed.origin}</p>
              <span class="mt-1 inline-block rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">Faible risque</span>
            </div>
          </a>
        );
      })}
    </div>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href="/fr/races/risque-moyen" class="rounded-full border border-gray-200 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-gray-50 transition-colors">Risque moyen →</a>
      <a href="/fr/races/risque-eleve" class="rounded-full border border-gray-200 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-gray-50 transition-colors">Risque élevé →</a>
      <a href="/fr/quiz/" class="rounded-full bg-green-600 px-4 py-2 text-sm font-semibold text-white hover:bg-green-700 transition-colors">Faire le quiz →</a>
    </div>
  </div>
</Layout>
