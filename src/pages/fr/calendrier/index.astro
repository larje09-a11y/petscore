---
import Layout from '@/components/Layout.astro';
import PetCalendar from '@/components/PetCalendar.tsx';
import breedsRaw from '@/data/breeds.json';
import type { Breed } from '@/types/breed';

const breeds = (breedsRaw as Breed[]).sort((a, b) => a.popularityRank - b.popularityRank);
---

<Layout
  title="Calendrier Santé Chien 2026 — PetScore™"
  description="Calendrier personnalisé des soins vétérinaires pour votre chien au Québec : vaccins, vermifugation, antiparasitaires, bilans de santé selon la race et l'âge."
  canonicalUrl="/fr/calendrier/"
>
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6">

    <!-- En-tête -->
    <div class="mb-10 text-center">
      <div class="mb-3 inline-flex items-center gap-2 rounded-full bg-green-50 px-4 py-1.5 text-sm font-medium text-green-700">
        📅 Outil gratuit
      </div>
      <h1 class="font-display text-4xl font-bold tracking-tight text-gray-900">
        PetCalendar™ — Calendrier Santé 2026
      </h1>
      <p class="mt-3 max-w-2xl mx-auto text-lg text-slate-500">
        Planifiez les soins vétérinaires de votre chien mois par mois : vaccins, antiparasitaires, bilans, soins dentaires.
        Adapté à la race et à l'âge.
      </p>
    </div>

    <!-- Calendrier interactif -->
    <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
      <PetCalendar client:load breeds={breeds} />
    </div>

    <!-- Bloc info complémentaire -->
    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      <div class="rounded-2xl bg-blue-50 p-5">
        <p class="text-2xl mb-2">💊</p>
        <h3 class="font-display font-semibold text-gray-900 mb-1">Vermifugation</h3>
        <p class="text-sm text-slate-600">
          4 fois par an recommandé pour les adultes en bonne santé. Votre vétérinaire peut adapter la fréquence.
        </p>
      </div>
      <div class="rounded-2xl bg-emerald-50 p-5">
        <p class="text-2xl mb-2">🛡️</p>
        <h3 class="font-display font-semibold text-gray-900 mb-1">Antiparasitaires</h3>
        <p class="text-sm text-slate-600">
          Saison des tiques au Québec : mars à octobre. Certains produits couvrent aussi les puces toute l'année.
        </p>
      </div>
      <div class="rounded-2xl bg-purple-50 p-5">
        <p class="text-2xl mb-2">💉</p>
        <h3 class="font-display font-semibold text-gray-900 mb-1">Vaccins obligatoires QC</h3>
        <p class="text-sm text-slate-600">
          La rage est légalement obligatoire au Québec. Les vaccins DA2PP, Bordetella et leptospirose sont recommandés.
        </p>
      </div>
    </div>

    <!-- Liens utiles -->
    <div class="mt-8 rounded-2xl border border-gray-100 bg-gray-50 p-6">
      <h2 class="font-display text-lg font-bold text-gray-900 mb-4">Ressources complémentaires</h2>
      <div class="grid gap-3 sm:grid-cols-2">
        <a href="/fr/urgence/" class="flex items-center gap-3 rounded-xl bg-white border border-gray-100 p-3 text-sm hover:border-red-200 hover:bg-red-50 transition-all">
          <span class="text-xl">🚨</span>
          <div>
            <p class="font-semibold text-gray-800">Calculateur d'urgence vétérinaire</p>
            <p class="text-xs text-slate-400">Évaluer l'urgence des symptômes de votre chien</p>
          </div>
        </a>
        <a href="/fr/assurance/" class="flex items-center gap-3 rounded-xl bg-white border border-gray-100 p-3 text-sm hover:border-green-200 hover:bg-green-50 transition-all">
          <span class="text-xl">🛡️</span>
          <div>
            <p class="font-semibold text-gray-800">Comparer les assurances animaux</p>
            <p class="text-xs text-slate-400">Meilleures assurances vétérinaires au Québec 2026</p>
          </div>
        </a>
        <a href="/fr/races/" class="flex items-center gap-3 rounded-xl bg-white border border-gray-100 p-3 text-sm hover:border-green-200 hover:bg-green-50 transition-all">
          <span class="text-xl">🐕</span>
          <div>
            <p class="font-semibold text-gray-800">Fiches races de chiens</p>
            <p class="text-xs text-slate-400">PetScore™, coûts et risques pour 50+ races</p>
          </div>
        </a>
        <a href="/fr/blog/" class="flex items-center gap-3 rounded-xl bg-white border border-gray-100 p-3 text-sm hover:border-green-200 hover:bg-green-50 transition-all">
          <span class="text-xl">📝</span>
          <div>
            <p class="font-semibold text-gray-800">Blog santé canine</p>
            <p class="text-xs text-slate-400">Conseils vétérinaires et guides pratiques</p>
          </div>
        </a>
      </div>
    </div>

  </div>
</Layout>
